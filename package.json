{
  "name": "dsh-plugin-health-check",
  "version": "0.3.0",
  "description": "Read-only plugin health checks for DeepSeek Harness (DSH): profiles, bundles, patches, version compatibility and MCP conflicts, with pre-install candidate checks.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-plugin-health-check": "scripts/dsh_health_check.mjs"
  },
  "files": [
    "src",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/dsh*.test.mjs",
    "check:dsh": "node scripts/dsh_health_check.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "js-yaml": "4.3.2",
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GlariaLuminous/dsh-plugin-health-check.git"
  },
  "homepage": "https://github.com/GlariaLuminous/dsh-plugin-health-check#readme",
  "bugs": {
    "url": "https://github.com/GlariaLuminous/dsh-plugin-health-check/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "health-check",
    "doctor",
    "mcp",
    "static-analysis"
  ]
}
